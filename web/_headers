# Cloudflare Pages — cabeçalhos.
# O motor (zip, roda, KaTeX) muda quando o código muda, e o nome não muda
# junto; por isso cache curto com revalidação em vez de cache eterno.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

/vendor/katex/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/sucuri-motor.zip
  Cache-Control: public, max-age=300, must-revalidate

/*.js
  Cache-Control: public, max-age=300, must-revalidate
